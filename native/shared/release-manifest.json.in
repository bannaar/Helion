{
  "manifest_version": 1,
  "project": "HELION",
  "version": "@PROJECT_VERSION@",
  "git_revision": "@HELION_GIT_REVISION@",
  "dirty": @HELION_DIRTY@,
  "source_sha256": "@HELION_SOURCE_DIGEST@",
  "configuration_sha256": "@HELION_CONFIG_DIGEST@",
  "build_id": "@HELION_BUILD_ID@",
  "release_channel": "@HELION_RELEASE_CHANNEL@",
  "package_kind": "@HELION_PACKAGE_FLAVOR@",
  "components": [@HELION_COMPONENTS@],
  "server_environments": [@HELION_SERVER_ENVIRONMENTS@],
  "build_type": "@CMAKE_BUILD_TYPE@",
  "compiler_id": "@CMAKE_CXX_COMPILER_ID@",
  "compiler_version": "@CMAKE_CXX_COMPILER_VERSION@",
  "tls_minimum": "1.2",
  "legacy_protocol": 2,
  "binary_protocol": 1,
  "persistence_compatibility": "persistence-admin1",
  "backup_envelope": "HELION_BACKUP_V1",
  "client_server_compatibility": "helion-tls-legacy2-binary1",
  "supported_migrations": ["development-untagged-P-H", "owned-ships", "economy", "galaxy-28-90-200", "knowledge-v1", "admin-ledger-v1"],
  "reverse_migration": false
}
