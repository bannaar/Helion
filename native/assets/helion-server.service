[Unit]
Description=Helion authoritative game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helion
Group=helion
UMask=0077
WorkingDirectory=/var/lib/helion
ExecStart=/usr/bin/helion_server 4242 /var/lib/helion/commander.db --environment production --bind 127.0.0.1 --cert /etc/helion/server.crt --key /etc/helion/server.key --drain-seconds 5 --maintenance-warning-seconds 60
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/helion
LimitNOFILE=4096
KillSignal=SIGTERM
KillMode=control-group
# Includes drain, TLS worker join, durable checkpoint and verified local backup.
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
