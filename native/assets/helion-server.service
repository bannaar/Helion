[Unit]
Description=Helion authoritative game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helion
Group=helion
UMask=0077
WorkingDirectory=/var/lib/helion
ExecStart=/usr/bin/helion_server 4242 /var/lib/helion/commander.db --environment development --bind 127.0.0.1 --cert /etc/helion/server.crt --key /etc/helion/server.key
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/helion
LimitNOFILE=4096
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
