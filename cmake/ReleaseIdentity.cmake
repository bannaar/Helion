# Release metadata is descriptive, never authentication or gameplay policy.
set(HELION_RELEASE_CHANNEL "STABLE" CACHE STRING "Artifact channel: STABLE or TEST")
set_property(CACHE HELION_RELEASE_CHANNEL PROPERTY STRINGS STABLE TEST)
if(NOT HELION_RELEASE_CHANNEL MATCHES "^(STABLE|TEST)$")
  message(FATAL_ERROR "HELION_RELEASE_CHANNEL must be STABLE or TEST")
endif()
find_package(Git QUIET)
set(HELION_GIT_REVISION "unversioned")
set(HELION_DIRTY "true")
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(revision MATCHES "^[0-9a-f]+$")
    set(HELION_GIT_REVISION "${revision}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" diff --quiet HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
      RESULT_VARIABLE changed)
    if(changed EQUAL 0)
      set(HELION_DIRTY "false")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" ls-files --others --exclude-standard -- native cmake docs CMakeLists.txt README.md
      WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_VARIABLE untracked)
    if(untracked)
      set(HELION_DIRTY "true")
    endif()
  endif()
endif()
# Fingerprint the actual release inputs, including newly authored source files.
# Explicit trees avoid tooling directories, private data and build artifacts.
file(GLOB_RECURSE release_inputs RELATIVE "${PROJECT_SOURCE_DIR}" CONFIGURE_DEPENDS
  "${PROJECT_SOURCE_DIR}/native/*.cpp" "${PROJECT_SOURCE_DIR}/native/*.h"
  "${PROJECT_SOURCE_DIR}/native/*.in" "${PROJECT_SOURCE_DIR}/native/*.cmake"
  "${PROJECT_SOURCE_DIR}/native/scripts/*" "${PROJECT_SOURCE_DIR}/native/assets/*"
  "${PROJECT_SOURCE_DIR}/docs/*" "${PROJECT_SOURCE_DIR}/cmake/*")
list(APPEND release_inputs CMakeLists.txt native/CMakeLists.txt README.md)
list(FILTER release_inputs EXCLUDE REGEX "(^|/)(build[^/]*|__pycache__)/")
list(SORT release_inputs)
set(input_hashes "")
foreach(path IN LISTS release_inputs)
  if(NOT IS_DIRECTORY "${PROJECT_SOURCE_DIR}/${path}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${path}")
    file(SHA256 "${PROJECT_SOURCE_DIR}/${path}" hash)
    string(APPEND input_hashes "${path}:${hash}\n")
  endif()
endforeach()
string(SHA256 HELION_SOURCE_DIGEST "${input_hashes}")
string(SHA256 HELION_CONFIG_DIGEST
  "${PROJECT_VERSION};${HELION_RELEASE_CHANNEL};${HELION_PACKAGE_FLAVOR};${CMAKE_BUILD_TYPE};${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_CXX_FLAGS};${CMAKE_CXX_FLAGS_DEBUG};${CMAKE_CXX_FLAGS_RELEASE};${HELION_BUILD_SERVER};${HELION_BUILD_CLIENT};${HELION_SANITIZERS};${CMAKE_SYSTEM_NAME};${CMAKE_SYSTEM_PROCESSOR}")
set(HELION_BUILD_ID "${HELION_GIT_REVISION}-${HELION_SOURCE_DIGEST}-${HELION_CONFIG_DIGEST}")
set(HELION_COMPONENTS "")
set(HELION_SERVER_ENVIRONMENTS "\"development\",\"test\",\"production\"")
if(HELION_RELEASE_CHANNEL STREQUAL "TEST")
  set(HELION_SERVER_ENVIRONMENTS "\"development\",\"test\"")
endif()
if(HELION_BUILD_SERVER)
  set(HELION_COMPONENTS "\"server\"")
endif()
if(HELION_BUILD_CLIENT)
  if(HELION_COMPONENTS)
    string(APPEND HELION_COMPONENTS ",")
  endif()
  string(APPEND HELION_COMPONENTS "\"client\"")
endif()
configure_file(native/shared/release-manifest.json.in generated/release-manifest.json @ONLY)
file(READ "${PROJECT_BINARY_DIR}/generated/release-manifest.json" HELION_MANIFEST_JSON)
configure_file(native/shared/build_identity.h.in generated/shared/build_identity.h @ONLY)
